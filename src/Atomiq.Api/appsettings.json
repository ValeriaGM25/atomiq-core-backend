{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Mongo": {
    "DatabaseName": "atomiq",
    "ConnectionString": ""
  },
  "Gemini": {
    "BaseUrl": "https://generativelanguage.googleapis.com/",
    "Model": "gemini-3.5-flash-lite",
    "ApiKey": "",
    "TimeoutMilliseconds": 2500,
    "MaxOutputWords": 25,
    "Enabled": false,
    "CacheTtlHours": 24,
    "CacheSizeLimit": 1024,
    "Language": "es",
    "PromptVersion": "v1"
  },
  "Authentication": {
    "DeviceTokens": {}
  },
  "RateLimiting": {
    "PermitLimit": 60,
    "WindowSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
}
